# 공개 서버의 HTTPS 진입점. nginx 공식 이미지가 기동 시 ${APP_DOMAIN}만 치환한다
# (정의되지 않은 변수인 $host 등은 그대로 남는다). 절차는 docs/deploy_https.md 참고.

server {
    listen 80;
    server_name ${APP_DOMAIN};

    # Let's Encrypt 갱신용 HTTP-01 인증
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 6m;

    location / {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        # 덮어쓴다(추가하지 않는다). 방문자가 보낸 X-Forwarded-For로 IP별 세션 상한을 우회하지 못하게
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;   # LLM 대기가 길다
    }
}
